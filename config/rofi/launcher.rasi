* {
  bg: #181825ee;
  bg-alt: #1e1e2e;
  fg: #cdd6f4;
  accent: #89b4fa;
  background-color: transparent;
  text-color: @fg;
}
window {
  width: 650px;
  border: 1px;
  border-color: @fg;
  border-radius: 14px;
  background-color: @bg;
}
mainbox { padding: 24px; spacing: 16px; children: [inputbar, listview]; }
inputbar {
  padding: 12px 18px;
  border: 1px;
  border-color: @fg;
  border-radius: 40px;
  background-color: @bg-alt;
  spacing: 10px;
  children: [prompt, entry];
}
prompt { text-color: @accent; }
entry { placeholder: "Search"; }
listview { lines: 7; columns: 1; spacing: 6px; scrollbar: false; }
element { padding: 8px 14px; spacing: 12px; border-radius: 12px; }
element selected.normal { background-color: @accent; text-color: #181825; }
element-icon { size: 26px; }
